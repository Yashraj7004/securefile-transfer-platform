{
  "name": "securefile-platform",
  "version": "1.0.0",
  "description": "SecureFile Transfer Platform - Production-Style Full-Stack Encrypted File Storage and Sharing",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "test": "cd server && npm test",
    "build:client": "cd client && npm run build",
    "build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.0.5"
  },
  "keywords": [
    "file-transfer",
    "encryption",
    "aes-256",
    "react",
    "express",
    "mongodb"
  ],
